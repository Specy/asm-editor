{
    "scope": "mips",
    "queries": [
        { "query": "add", "first": "mips/instructions/add" },
        { "query": "lw", "first": "mips/instructions/lw" },
        { "query": ".data", "first": "mips/directives/data" },
        { "query": "data", "first": "mips/directives/data" },
        { "query": "$t3", "first": "mips/registers/$t0 - $t7" },
        { "query": "printf", "first": "mips/runtime-library/printf" },
        { "query": "malloc", "first": "mips/runtime-library/malloc" },
        { "query": "qsort", "first": "mips/runtime-library/qsort" },
        { "query": "print an integer", "top": 1, "expect": "mips/syscalls/1" },
        { "query": "how do I print a number", "top": 3, "expect": "mips/syscalls/1" },
        { "query": "read a string from the keyboard", "top": 3, "expect": "mips/syscalls/8" },
        { "query": "exit the program", "top": 3, "expect": "mips/syscalls/10" },
        { "query": "sleep for a second", "top": 3, "expect": "mips/syscalls/32" },
        { "query": "bitmap display", "first": "mips/screen/bitmap-display" },
        {
            "query": "divide and get the remainder",
            "top": 3,
            "expect": ["mips/instructions/div", "mips/instructions/rem"]
        },
        {
            "query": "what is the stack",
            "top": 3,
            "expect": "assembly-basics/think-in-assembly/the-stack#"
        },
        {
            "query": "loop over an array",
            "top": 3,
            "expect": [
                "mips/think-in-assembly/loops#",
                "assembly-basics/think-in-assembly/loops#",
                "mips/think-in-assembly/arrays-and-strings#"
            ],
            "meaning": true
        },
        {
            "query": "call a function and return",
            "top": 3,
            "expect": [
                "mips/think-in-assembly/jal-jr-and-the-calling-convention#a-call-inside-a-subroutine",
                "mips/instructions/jal",
                "mips/registers/$ra"
            ],
            "meaning": true
        }
    ]
}
