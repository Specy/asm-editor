{
    "scope": "risc-v",
    "queries": [
        {
            "query": "addi",
            "first": "risc-v/instructions/addi"
        },
        {
            "query": "ecall",
            "first": "risc-v/instructions/ecall"
        },
        {
            "query": ".word",
            "first": "risc-v/directives/word"
        },
        {
            "query": "a3",
            "first": "risc-v/registers/general-registers-a2-a7"
        },
        {
            "query": "printf",
            "first": "risc-v/runtime-library/printf"
        },
        {
            "query": "malloc",
            "first": "risc-v/runtime-library/malloc"
        },
        {
            "query": "qsort",
            "first": "risc-v/runtime-library/qsort"
        },
        {
            "query": "print an integer",
            "top": 1,
            "expect": "risc-v/syscalls/1"
        },
        {
            "query": "exit the program",
            "top": 3,
            "expect": "risc-v/syscalls/10"
        },
        {
            "query": "read a character",
            "top": 3,
            "expect": "risc-v/syscalls/12"
        },
        {
            "query": "random number",
            "top": 4,
            "expect": "risc-v/syscalls/41"
        },
        {
            "query": "floating point registers",
            "top": 3,
            "expect": "risc-v/registers/fpu"
        },
        {
            "query": "control and status registers",
            "top": 3,
            "expect": "risc-v/registers/csr"
        },
        {
            "query": "shift left",
            "top": 3,
            "expect": [
                "risc-v/instructions/slli",
                "risc-v/instructions/sll",
                "risc-v/think-in-assembly/arithmetic-logic-and-bits#shifts"
            ]
        },
        {
            "query": "go 64 bit",
            "top": 3,
            "expect": "risc-v/introduction/going-64-bit#",
            "meaning": true
        },
        {
            "query": "draw a pixel",
            "top": 5,
            "expect": [
                "risc-v/screen/bitmap-display",
                "risc-v/examples/drawing-on-the-screen#",
                "risc-v/talking-to-the-outside-world/the-bitmap-display-and-the-keyboard#finding-a-pixel"
            ]
        },
        {
            "query": "libraries and simulator services",
            "top": 5,
            "expect": "risc-v/using-c/libraries"
        },
        {
            "query": "screen and device registers",
            "top": 5,
            "expect": "risc-v/using-c/screen-and-devices"
        },
        {
            "query": "GetCWD service 17",
            "top": 5,
            "expect": "risc-v/syscalls/17"
        }
    ]
}
