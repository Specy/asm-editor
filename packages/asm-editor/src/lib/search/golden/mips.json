{
    "scope": "mips",
    "queries": [
        {
            "query": "add",
            "first": "mips/instructions/add"
        },
        {
            "query": "lw",
            "first": "mips/instructions/lw"
        },
        {
            "query": ".data",
            "first": "mips/directives/data"
        },
        {
            "query": "data",
            "first": "mips/directives/data"
        },
        {
            "query": "$t3",
            "first": "mips/registers/$t0 - $t7"
        },
        {
            "query": "printf",
            "first": "mips/runtime-library/printf"
        },
        {
            "query": "malloc",
            "first": "mips/runtime-library/malloc"
        },
        {
            "query": "qsort",
            "first": "mips/runtime-library/qsort"
        },
        {
            "query": "print an integer",
            "top": 1,
            "expect": "mips/syscalls/1"
        },
        {
            "query": "how do I print a number",
            "top": 3,
            "expect": "mips/syscalls/1"
        },
        {
            "query": "read a string from the keyboard",
            "top": 3,
            "expect": "mips/syscalls/8"
        },
        {
            "query": "exit the program",
            "top": 3,
            "expect": "mips/syscalls/10"
        },
        {
            "query": "sleep for a second",
            "top": 3,
            "expect": "mips/syscalls/32"
        },
        {
            "query": "bitmap display",
            "first": "mips/screen/bitmap-display"
        },
        {
            "query": "divide and get the remainder",
            "top": 3,
            "expect": ["mips/instructions/div", "mips/instructions/rem"]
        },
        {
            "query": "what is the stack",
            "top": 3,
            "expect": "assembly-basics/think-in-assembly/the-stack#"
        },
        {
            "query": "loop over an array",
            "top": 3,
            "expect": [
                "mips/think-in-assembly/loops#",
                "assembly-basics/think-in-assembly/loops#",
                "mips/think-in-assembly/arrays-and-strings#"
            ],
            "meaning": true
        },
        {
            "query": "call a function and return",
            "top": 3,
            "expect": [
                "mips/think-in-assembly/jal-jr-and-the-calling-convention#a-call-inside-a-subroutine",
                "mips/instructions/jal",
                "mips/registers/$ra"
            ],
            "meaning": true
        },
        {
            "query": "libraries and simulator services",
            "top": 5,
            "expect": "mips/using-c/libraries"
        },
        {
            "query": "screen and device registers",
            "top": 5,
            "expect": "mips/using-c/screen-and-devices"
        },
        {
            "query": "seed random generator service 40",
            "top": 5,
            "expect": "mips/syscalls/40"
        },
        {
            "query": "lw $t0, 4($sp)",
            "first": "mips/instructions/lw"
        },
        {
            "query": "add $t0, $t1, $t2",
            "first": "mips/instructions/add"
        },
        {
            "query": "add two numbers",
            "top": 3,
            "expect": "mips/instructions/add",
            "meaning": true
        },
        {
            "query": "directive for strings",
            "top": 3,
            "expect": [
                "mips/directives/ascii",
                "mips/directives/asciiz",
                "mips/directives/asciz",
                "mips/directives/string"
            ],
            "meaning": true
        },
        {
            "query": "quit with an error code",
            "top": 3,
            "expect": "mips/syscalls/17"
        },
        {
            "query": "put a constant in a register",
            "top": 3,
            "expect": "mips/instructions/li",
            "meaning": true
        },
        {
            "query": "pause for a few milliseconds",
            "top": 3,
            "expect": "mips/syscalls/32"
        },
        {
            "query": "end directive",
            "first": "mips/directives/end"
        },
        {
            "query": "sp register",
            "first": "mips/registers/$sp"
        }
    ]
}
