; termios.inc: the constants and structures of <termios.h> for NASM, under the same names: struct
; termios and its mode bits, which the TCGETS and TCSETS ioctls of sys/ioctl.inc read and set:
; turning ICANON off in c_lflag gives each key as it is typed, and turning ECHO off stops typed keys
; from being shown.
;
; A structure is a struc: name.field is a field's offset, name.outer.inner one of a structure inside
; it, and name_size its size. Use it as [rdi + input_event.code], or reserve one with resb
; input_event_size.
;
; Generated by scripts/sim-header/generate.mjs from scripts/sim-header/deviceTable.mjs. Do not edit
; it: regenerate it.
%ifndef TERMIOS_INC
%define TERMIOS_INC

%define NCCS 32 ; How many special characters c_cc holds.

; The Terminal's modes, as tcgetattr reads them and tcsetattr sets them. The kernel reads and writes
; the fields up to c_cc[18].
; termios_size is 60.
struc termios
    .c_iflag:  resd 1  ; Input modes: ICRNL, IXON, ...
    .c_oflag:  resd 1  ; Output modes: OPOST, ONLCR.
    .c_cflag:  resd 1  ; Line modes: CS8, ...
    .c_lflag:  resd 1  ; Local modes: ICANON, ECHO, ISIG, ...
    .c_line:   resb 1
    .c_cc:     resb 32 ; The special characters, by the V* numbers below.
               resb 3  ; padding.
    .c_ispeed: resd 1
    .c_ospeed: resd 1
endstruc

; Where each special character is in c_cc. VMIN and VTIME say what a read waits for when ICANON is
; off: VMIN bytes, or VTIME tenths of a second after the first one.
%define VINTR    0 ; Ctrl+C, which sends SIGINT under ISIG.
%define VQUIT    1 ; Ctrl+\, which sends SIGQUIT under ISIG.
%define VERASE   2
%define VKILL    3
%define VEOF     4 ; Ctrl+D.
%define VTIME    5
%define VMIN     6
%define VSWTC    7
%define VSTART   8
%define VSTOP    9
%define VSUSP    10
%define VEOL     11
%define VREPRINT 12
%define VDISCARD 13
%define VWERASE  14
%define VLNEXT   15
%define VEOL2    16

; c_iflag: how typed input is processed.
%define IGNBRK  0o1
%define BRKINT  0o2
%define IGNPAR  0o4
%define PARMRK  0o10
%define INPCK   0o20
%define ISTRIP  0o40   ; Clear the top bit of every byte.
%define INLCR   0o100
%define IGNCR   0o200
%define ICRNL   0o400  ; Enter gives '\n' instead of '\r'.
%define IUCLC   0o1000
%define IXON    0o2000 ; Ctrl+S and Ctrl+Q stop and restart output (ignored here)
%define IXANY   0o4000
%define IXOFF   0o10000
%define IMAXBEL 0o20000
%define IUTF8   0o40000

; c_oflag: how output is processed.
%define OPOST  0o1 ; Process output at all.
%define OLCUC  0o2
%define ONLCR  0o4 ; Write '\n' as '\r' '\n'.
%define OCRNL  0o10
%define ONOCR  0o20
%define ONLRET 0o40
%define OFILL  0o100
%define OFDEL  0o200

; c_cflag: the serial line's settings.
%define CSIZE  0o60 ; The bits that hold the character size.
%define CS5    0
%define CS6    0o20
%define CS7    0o40
%define CS8    0o60 ; 8-bit characters.
%define CSTOPB 0o100
%define CREAD  0o200
%define PARENB 0o400
%define PARODD 0o1000
%define HUPCL  0o2000
%define CLOCAL 0o4000

; c_lflag: line editing, echo and signals.
%define ISIG    0o1  ; Ctrl+C and Ctrl+\ send signals.
%define ICANON  0o2  ; Canonical mode: reads get whole lines, which can be edited first.
%define ECHO    0o10 ; Show typed characters.
%define ECHOE   0o20
%define ECHOK   0o40
%define ECHONL  0o100
%define NOFLSH  0o200
%define TOSTOP  0o400
%define ECHOCTL 0o1000
%define ECHOPRT 0o2000
%define ECHOKE  0o4000
%define FLUSHO  0o10000
%define PENDIN  0o40000
%define IEXTEN  0o100000
%define EXTPROC 0o200000

; When tcsetattr's change takes effect.
%define TCSANOW   0 ; At once.
%define TCSADRAIN 1 ; Once the output has been sent.
%define TCSAFLUSH 2 ; Once the output has been sent, discarding the input not read yet.

%endif
