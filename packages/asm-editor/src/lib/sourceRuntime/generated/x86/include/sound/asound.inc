; sound/asound.inc: the constants and structures of <sound/asound.h> for NASM, under the same names:
; ALSA's raw MIDI part, /dev/snd/midiC1D0: MIDI bytes written to the port play on the General MIDI
; synthesizer, at MIDI's 31,250 baud. These requests ask about the port and its buffer.
;
; A structure is a struc: name.field is a field's offset, name.outer.inner one of a structure inside
; it, and name_size its size. Use it as [rdi + input_event.code], or reserve one with resb
; input_event_size.
;
; Generated by scripts/sim-header/generate.mjs from scripts/sim-header/deviceTable.mjs. Do not edit
; it: regenerate it.
%ifndef SOUND_ASOUND_INC
%define SOUND_ASOUND_INC

%include "time.inc"

; A version number from its three parts.
%define SNDRV_PROTOCOL_VERSION(major,minor,subminor) (((major) << 16) | ((minor) << 8) | (subminor))

; What SNDRV_RAWMIDI_IOCTL_PVERSION answers on the guest's Linux 7.2.
%define SNDRV_RAWMIDI_VERSION SNDRV_PROTOCOL_VERSION(2, 0, 5)

; The two directions of a port.
%define SNDRV_RAWMIDI_STREAM_OUTPUT 0 ; From the program to the synthesizer.
%define SNDRV_RAWMIDI_STREAM_INPUT  1
%define SNDRV_RAWMIDI_STREAM_LAST   SNDRV_RAWMIDI_STREAM_INPUT

; snd_rawmidi_info's flags.
%define SNDRV_RAWMIDI_INFO_OUTPUT 0x1
%define SNDRV_RAWMIDI_INFO_INPUT  0x2
%define SNDRV_RAWMIDI_INFO_DUPLEX 0x4
%define SNDRV_RAWMIDI_INFO_UMP    0x8

; What SNDRV_RAWMIDI_IOCTL_INFO reads: which card and device the port is, and its names.
; snd_rawmidi_info_size is 268.
struc snd_rawmidi_info
    .device:           resd 1
    .subdevice:        resd 1
    .stream:           resd 1 ; Which direction to ask about, set before the call.
    .card:             resd 1 ; 1 here: the card after the sound card.
    .flags:            resd 1 ; SNDRV_RAWMIDI_INFO_*.
    .id:               resb 64
    .name:             resb 80
    .subname:          resb 32
    .subdevices_count: resd 1
    .subdevices_avail: resd 1
    .tied_device:      resd 1 ; The device tied to this one, 0 here.
    .reserved:         resb 60
endstruc

; snd_rawmidi_params's mode, for input only.
%define SNDRV_RAWMIDI_MODE_FRAMING_MASK  (7 << 0)
%define SNDRV_RAWMIDI_MODE_FRAMING_SHIFT 0
%define SNDRV_RAWMIDI_MODE_FRAMING_NONE  (0 << 0)
%define SNDRV_RAWMIDI_MODE_FRAMING_TSTAMP (1 << 0)
%define SNDRV_RAWMIDI_MODE_CLOCK_MASK    (7 << 3)
%define SNDRV_RAWMIDI_MODE_CLOCK_SHIFT   3
%define SNDRV_RAWMIDI_MODE_CLOCK_NONE    (0 << 3)
%define SNDRV_RAWMIDI_MODE_CLOCK_REALTIME (1 << 3)
%define SNDRV_RAWMIDI_MODE_CLOCK_MONOTONIC (2 << 3)
%define SNDRV_RAWMIDI_MODE_CLOCK_MONOTONIC_RAW (3 << 3)

; What SNDRV_RAWMIDI_IOCTL_PARAMS sets: the size of the port's buffer.
; snd_rawmidi_params_size is 48.
struc snd_rawmidi_params
    .stream:            resd 1
                        resb 4 ; padding.
    .buffer_size:       resq 1 ; The buffer's size in bytes.
    .avail_min:         resq 1 ; How much room a write waits for.
    .no_active_sensing: resd 1 ; Do not send Active Sensing at close: bit 0 of this dword.
    .mode:              resd 1
    .reserved:          resb 12
                        resb 4 ; padding.
endstruc

; Padding that puts the next field where a time_t would align it.
; __time_pad_size is 4.
struc __time_pad
    .pad: resb 4
endstruc

; What SNDRV_RAWMIDI_IOCTL_STATUS reads: the room in the port's buffer.
; snd_rawmidi_status_size is 56.
struc snd_rawmidi_status
    .stream:         resd 1 ; Which direction to ask about, set before the call.
    .pad1:
    .pad1.pad:       resb 4
    .tstamp:                ; When it was asked.
    .tstamp.tv_sec:  resq 1 ; Whole seconds.
    .tstamp.tv_nsec: resq 1 ; Nanoseconds, 0 to 999999999.
    .avail:          resq 1 ; Bytes free in the buffer.
    .xruns:          resq 1
    .reserved:       resb 16
endstruc

; The requests.
; _IOR('W', 0x00, int): the protocol version, SNDRV_RAWMIDI_VERSION, into an int.
%define SNDRV_RAWMIDI_IOCTL_PVERSION 0x80045700
; _IOR('W', 0x01, struct snd_rawmidi_info): the port's identity.
%define SNDRV_RAWMIDI_IOCTL_INFO     0x810c5701
; _IOWR('W', 0x10, struct snd_rawmidi_params): change the buffer.
%define SNDRV_RAWMIDI_IOCTL_PARAMS   0xc0305710
; _IOWR('W', 0x20, struct snd_rawmidi_status): the buffer's state.
%define SNDRV_RAWMIDI_IOCTL_STATUS   0xc0385720
; _IOW('W', 0x30, int): drop the bytes not sent yet; the argument points to the stream.
%define SNDRV_RAWMIDI_IOCTL_DROP     0x40045730
; _IOW('W', 0x31, int): wait until every byte has been sent; the argument points to the stream.
%define SNDRV_RAWMIDI_IOCTL_DRAIN    0x40045731

%endif
