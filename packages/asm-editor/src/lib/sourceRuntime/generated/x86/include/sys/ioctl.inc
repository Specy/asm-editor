; sys/ioctl.inc: the constants and structures of <sys/ioctl.h> for NASM, under the same names: the
; Terminal's ioctl requests and struct winsize.
;
; A structure is a struc: name.field is a field's offset, name.outer.inner one of a structure inside
; it, and name_size its size. Use it as [rdi + input_event.code], or reserve one with resb
; input_event_size.
;
; Generated by scripts/sim-header/generate.mjs from scripts/sim-header/deviceTable.mjs. Do not edit
; it: regenerate it.
%ifndef SYS_IOCTL_INC
%define SYS_IOCTL_INC

%include "linux/ioctl.inc"

; The Terminal's requests. <termios.h>'s functions make the first four for you.
%define TCGETS     0x5401 ; Read the terminal's struct termios.
%define TCSETS     0x5402 ; Change it now.
%define TCSETSW    0x5403 ; Change it once the output has been sent.
%define TCSETSF    0x5404 ; Same, and discard the input not read yet.
%define TCSBRK     0x5409 ; With an argument other than 0, wait until the output has been sent.
%define TCFLSH     0x540b ; Discard the input not read yet (TCIFLUSH, TCIOFLUSH of <termios.h>)
%define TIOCGWINSZ 0x5413 ; Read the terminal's size into a struct winsize.
%define TIOCSWINSZ 0x5414 ; Set the size a struct winsize gives.
%define FIONREAD   0x541b ; How many bytes a read would get now, into an int.
%define TIOCINQ    FIONREAD
%define FIONBIO    0x5421 ; Turn O_NONBLOCK on (an int other than 0) or off (0)

; The terminal's size, which TIOCGWINSZ reads.
; winsize_size is 8.
struc winsize
    .ws_row:    resw 1 ; Rows of characters.
    .ws_col:    resw 1 ; Columns of characters.
    .ws_xpixel: resw 1
    .ws_ypixel: resw 1
endstruc

%endif
