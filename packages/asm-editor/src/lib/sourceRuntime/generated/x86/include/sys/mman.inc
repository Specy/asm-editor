; sys/mman.inc: the constants and structures of <sys/mman.h> for NASM, under the same names: the
; mmap system call's protections and flags: mapping /dev/fb0 gives the address of the Screen's
; pixels, written like any memory.
;
; A structure is a struc: name.field is a field's offset, name.outer.inner one of a structure inside
; it, and name_size its size. Use it as [rdi + input_event.code], or reserve one with resb
; input_event_size.
;
; Generated by scripts/sim-header/generate.mjs from scripts/sim-header/deviceTable.mjs. Do not edit
; it: regenerate it.
%ifndef SYS_MMAN_INC
%define SYS_MMAN_INC

; What the program may do with the mapped memory.
%define PROT_NONE  0 ; Nothing.
%define PROT_READ  1 ; Read it.
%define PROT_WRITE 2 ; Write it.
%define PROT_EXEC  4 ; Run it.

; How it is mapped: exactly one of the first two, then any of the others.
%define MAP_SHARED    0x1  ; Writes reach the device or file, and every mapping of it sees them.
%define MAP_PRIVATE   0x2  ; Writes stay in the program's own copy.
%define MAP_FIXED     0x10 ; Exactly at the address given.
%define MAP_ANONYMOUS 0x20 ; New zeroed memory, no file: pass -1 as the descriptor.
%define MAP_NORESERVE 0x4000
%define MAP_POPULATE  0x8000
%define MAP_ANON      MAP_ANONYMOUS

%endif
