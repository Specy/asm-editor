; linux/fb.inc: the constants and structures of <linux/fb.h> for NASM, under the same names: the
; framebuffer, /dev/fb0: the Screen as memory. FBIOGET_VSCREENINFO and FBIOGET_FSCREENINFO say how
; big it is and how a pixel is laid out (32 bits, 0x00RRGGBB), mmap maps its memory, and
; FBIOPAN_DISPLAY shows the other page of a double-buffered program.
;
; A structure is a struc: name.field is a field's offset, name.outer.inner one of a structure inside
; it, and name_size its size. Use it as [rdi + input_event.code], or reserve one with resb
; input_event_size.
;
; Generated by scripts/sim-header/generate.mjs from scripts/sim-header/deviceTable.mjs. Do not edit
; it: regenerate it.
%ifndef LINUX_FB_INC
%define LINUX_FB_INC

%include "linux/ioctl.inc"

%define FB_MAX 32 ; How many framebuffers Linux numbers.

; The requests.
%define FBIOGET_VSCREENINFO 0x4600 ; Read the struct fb_var_screeninfo.
%define FBIOPUT_VSCREENINFO 0x4601 ; Ask for another struct fb_var_screeninfo.
%define FBIOGET_FSCREENINFO 0x4602 ; Read the struct fb_fix_screeninfo.
%define FBIOPAN_DISPLAY     0x4606 ; Show the page at the fb_var_screeninfo's yoffset.
; _IOW('F', 0x20, __u32): wait for the next vertical blank, 1/60 s; the argument points to a __u32
; 0.
%define FBIO_WAITFORVSYNC   0x40044620

; fb_fix_screeninfo's type and visual.
%define FB_TYPE_PACKED_PIXELS        0 ; Each pixel's bits together, pixel after pixel.
%define FB_TYPE_PLANES               1
%define FB_TYPE_INTERLEAVED_PLANES   2
%define FB_TYPE_TEXT                 3
%define FB_TYPE_VGA_PLANES           4
%define FB_TYPE_FOURCC               5
%define FB_VISUAL_MONO01             0
%define FB_VISUAL_MONO10             1
%define FB_VISUAL_TRUECOLOR          2 ; Each pixel holds its color, as the bitfields say.
%define FB_VISUAL_PSEUDOCOLOR        3
%define FB_VISUAL_DIRECTCOLOR        4
%define FB_VISUAL_STATIC_PSEUDOCOLOR 5
%define FB_VISUAL_FOURCC             6
%define FB_ACCEL_NONE                0 ; No drawing hardware.

; What FBIOGET_FSCREENINFO reads: what the device is and how its memory is laid out, which a program
; cannot change.
; fb_fix_screeninfo_size is 80.
struc fb_fix_screeninfo
    .id:           resb 16 ; The driver's name: "bochs-drmdrmfb" here.
    .smem_start:   resq 1  ; The memory's physical address.
    .smem_len:     resd 1  ; The memory's size in bytes, every page: what to mmap.
    .type:         resd 1  ; FB_TYPE_PACKED_PIXELS.
    .type_aux:     resd 1
    .visual:       resd 1  ; FB_VISUAL_TRUECOLOR.
    .xpanstep:     resw 1  ; Steps panning can take, 0 if it cannot.
    .ypanstep:     resw 1
    .ywrapstep:    resw 1
                   resb 2  ; padding.
    .line_length:  resd 1  ; Bytes from one line to the next, which can be more than xres times 4.
                   resb 4  ; padding.
    .mmio_start:   resq 1
    .mmio_len:     resd 1
    .accel:        resd 1
    .capabilities: resw 1
    .reserved:     resw 2
                   resb 2  ; padding.
endstruc

; Where one color component is in a pixel: offset bits from the right, length bits long. XRGB8888
; has red at 16, green at 8 and blue at 0, each 8 long.
; fb_bitfield_size is 12.
struc fb_bitfield
    .offset:    resd 1
    .length:    resd 1
    .msb_right: resd 1 ; 0: the most significant bit is on the left.
endstruc

; fb_var_screeninfo's activate: when FBIOPUT_VSCREENINFO applies the change.
%define FB_ACTIVATE_NOW      0  ; At once.
%define FB_ACTIVATE_NXTOPEN  1
%define FB_ACTIVATE_TEST     2  ; Only check it.
%define FB_ACTIVATE_MASK     15
%define FB_ACTIVATE_VBL      16 ; At the next vertical blank.
%define FB_ACTIVATE_ALL      64
%define FB_ACTIVATE_FORCE    128
%define FB_ACTIVATE_INV_MODE 256

; fb_var_screeninfo's vmode and rotate.
%define FB_VMODE_NONINTERLACED 0
%define FB_VMODE_INTERLACED    1
%define FB_VMODE_DOUBLE        2
%define FB_VMODE_ODD_FLD_FIRST 4
%define FB_VMODE_MASK          255
%define FB_VMODE_YWRAP         256 ; Panning wraps around instead of stopping.
%define FB_VMODE_SMOOTH_XPAN   512
%define FB_VMODE_CONUPDATE     512
%define FB_ROTATE_UR           0
%define FB_ROTATE_CW           1
%define FB_ROTATE_UD           2
%define FB_ROTATE_CCW          3

; What FBIOGET_VSCREENINFO reads and FBIOPUT_VSCREENINFO asks for: the visible size, the size of the
; memory behind it, which part of it is shown, and how a pixel's bits are laid out.
; fb_var_screeninfo_size is 160.
struc fb_var_screeninfo
    .xres:             resd 1 ; The visible width, in pixels.
    .yres:             resd 1 ; The visible height.
    .xres_virtual:     resd 1 ; The width of the memory, in pixels.
    .yres_virtual:     resd 1 ; Its height: twice yres here, two pages.
    .xoffset:          resd 1 ; The first visible column.
    .yoffset:          resd 1 ; The first visible line: 0 shows the first page, yres the second.
    .bits_per_pixel:   resd 1 ; 32 here.
    .grayscale:        resd 1
    .red:                     ; Where each component is in a pixel.
    .red.offset:       resd 1
    .red.length:       resd 1
    .red.msb_right:    resd 1 ; 0: the most significant bit is on the left.
    .green:
    .green.offset:     resd 1
    .green.length:     resd 1
    .green.msb_right:  resd 1 ; 0: the most significant bit is on the left.
    .blue:
    .blue.offset:      resd 1
    .blue.length:      resd 1
    .blue.msb_right:   resd 1 ; 0: the most significant bit is on the left.
    .transp:
    .transp.offset:    resd 1
    .transp.length:    resd 1
    .transp.msb_right: resd 1 ; 0: the most significant bit is on the left.
    .nonstd:           resd 1
    .activate:         resd 1 ; FB_ACTIVATE_*.
    .height:           resd 1 ; The picture's height in millimetres, or -1.
    .width:            resd 1
    .accel_flags:      resd 1
    .pixclock:         resd 1 ; The video timing, which this display does not have.
    .left_margin:      resd 1
    .right_margin:     resd 1
    .upper_margin:     resd 1
    .lower_margin:     resd 1
    .hsync_len:        resd 1
    .vsync_len:        resd 1
    .sync:             resd 1
    .vmode:            resd 1 ; FB_VMODE_*.
    .rotate:           resd 1 ; FB_ROTATE_*.
    .colorspace:       resd 1
    .reserved:         resd 4
endstruc

%endif
