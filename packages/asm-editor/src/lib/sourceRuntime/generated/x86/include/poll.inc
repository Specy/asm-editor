; poll.inc: the constants and structures of <poll.h> for NASM, under the same names: struct pollfd
; and its events, for the poll system call, which waits on several descriptors at once with a
; timeout.
;
; A structure is a struc: name.field is a field's offset, name.outer.inner one of a structure inside
; it, and name_size its size. Use it as [rdi + input_event.code], or reserve one with resb
; input_event_size.
;
; Generated by scripts/sim-header/generate.mjs from scripts/sim-header/deviceTable.mjs. Do not edit
; it: regenerate it.
%ifndef POLL_INC
%define POLL_INC

; One descriptor to wait on, and what happened to it.
; pollfd_size is 8.
struc pollfd
    .fd:      resd 1 ; The descriptor; a negative one is skipped.
    .events:  resw 1 ; What to wait for: POLLIN, POLLOUT, ...
    .revents: resw 1 ; What happened, which poll fills in.
endstruc

%define POLLIN     0x1  ; There is something to read.
%define POLLPRI    0x2  ; There is urgent data to read.
%define POLLOUT    0x4  ; A write would not wait.
%define POLLERR    0x8  ; An error (revents only)
%define POLLHUP    0x10 ; The other end hung up (revents only)
%define POLLNVAL   0x20 ; The descriptor is not open (revents only)
%define POLLRDNORM 0x40
%define POLLRDBAND 0x80
%define POLLWRNORM 0x100
%define POLLWRBAND 0x200

%endif
