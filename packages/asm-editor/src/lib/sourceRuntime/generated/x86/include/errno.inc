; errno.inc: the constants and structures of <errno.h> for NASM, under the same names: the error
; numbers. The kernel answers a failed system call with one of them, negated, in rax: compare rax
; with -ENOTTY, or check for any failure with cmp rax, -4095 and jae.
;
; A structure is a struc: name.field is a field's offset, name.outer.inner one of a structure inside
; it, and name_size its size. Use it as [rdi + input_event.code], or reserve one with resb
; input_event_size.
;
; Generated by scripts/sim-header/generate.mjs from scripts/sim-header/deviceTable.mjs. Do not edit
; it: regenerate it.
%ifndef ERRNO_INC
%define ERRNO_INC

%define EPERM       1          ; Operation not permitted.
%define ENOENT      2          ; No such file or directory.
%define ESRCH       3          ; No such process: kill found no process with that id.
%define EINTR       4          ; Interrupted system call: a signal arrived while it waited.
%define EIO         5          ; Input/output error.
%define ENXIO       6          ; No such device or address.
%define EBADF       9          ; Bad file descriptor: not open, or not open for this.
%define EAGAIN      11         ; Try again: a non-blocking descriptor has nothing ready.
%define ENOMEM      12         ; Out of memory.
%define EACCES      13         ; Permission denied.
%define EFAULT      14         ; Bad address: a pointer argument points outside the program.
; Device or resource busy, such as an input device another reader grabbed.
%define EBUSY       16
%define EEXIST      17         ; File exists.
%define ENODEV      19         ; No such device: the device exists but has no driver here.
%define ENOTDIR     20         ; Not a directory.
%define EISDIR      21         ; Is a directory.
%define EINVAL      22         ; Invalid argument.
%define EMFILE      24         ; Too many open files.
; Inappropriate ioctl for device: the device does not know this request.
%define ENOTTY      25
%define EFBIG       27         ; File too large: a write starting past the end of /dev/fb0.
%define ENOSPC      28         ; No space left on device.
%define ESPIPE      29         ; Illegal seek.
%define EPIPE       32         ; Broken pipe.
%define EDOM        33         ; Argument out of domain.
%define ERANGE      34         ; Result out of range.
%define ENOSYS      38         ; Function not implemented.
%define EWOULDBLOCK EAGAIN     ; Same as EAGAIN.
%define EOVERFLOW   75         ; Value too large for defined data type.
%define EILSEQ      84         ; Invalid multibyte or wide character.
%define EOPNOTSUPP  95         ; Operation not supported.
%define ENOTSUP     EOPNOTSUPP ; Same as EOPNOTSUPP.

%endif
