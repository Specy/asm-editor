; linux/input.inc: the constants and structures of <linux/input.h> for NASM, under the same names:
; the input devices, /dev/input/event*: the keyboard, the tablet (the pointer) and the PC speaker. A
; read gives whole struct input_events, and the EVIOC* requests ask a device what it is and what it
; has.
;
; A structure is a struc: name.field is a field's offset, name.outer.inner one of a structure inside
; it, and name_size its size. Use it as [rdi + input_event.code], or reserve one with resb
; input_event_size.
;
; Generated by scripts/sim-header/generate.mjs from scripts/sim-header/deviceTable.mjs. Do not edit
; it: regenerate it.
%ifndef LINUX_INPUT_INC
%define LINUX_INPUT_INC

%include "sys/time.inc"
%include "sys/ioctl.inc"
%include "linux/input-event-codes.inc"

; One event, 24 bytes, as a read of an input device gives it: a key going down, a move along one
; axis, the end of a report. The events of one report end with an EV_SYN SYN_REPORT.
; input_event_size is 24.
struc input_event
    ; When it happened, CLOCK_REALTIME unless EVIOCSCLOCKID chose another clock.
    .time:
    .time.tv_sec:  resq 1 ; Whole seconds.
    .time.tv_usec: resq 1 ; Microseconds, 0 to 999999.
    .type:         resw 1 ; EV_KEY, EV_ABS, ...
    .code:         resw 1 ; KEY_A, ABS_X, ...
    .value:        resd 1 ; For a key 1 down, 0 up and 2 a repeat; for an axis the position.
endstruc

%define EV_VERSION 0x10001 ; What EVIOCGVERSION answers.

; What EVIOCGID reads: who made the device and how it is connected.
; input_id_size is 8.
struc input_id
    .bustype: resw 1 ; BUS_USB, BUS_I8042, ...
    .vendor:  resw 1
    .product: resw 1
    .version: resw 1
endstruc

; The current value and range of an absolute axis, read by EVIOCGABS. For this tablet, clamp (value
; * xres + 32766) / 32767 to 0 through xres - 1 to obtain a horizontal pixel coordinate; minimum is
; 0 and maximum is 32767.
; input_absinfo_size is 24.
struc input_absinfo
    .value:      resd 1 ; The position now.
    .minimum:    resd 1 ; Lowest axis value: 0 for the Screen tablet.
    .maximum:    resd 1 ; Highest axis value: 32767 for the Screen tablet.
    .fuzz:       resd 1
    .flat:       resd 1
    .resolution: resd 1
endstruc

; The requests. The ones with a len read up to len bytes into a buffer and return how many they
; wrote; the bit sets have one bit per code, the lowest bit of the first byte for code 0.
%define EVIOCGVERSION 0x80044501 ; _IOR('E', 0x01, int): the evdev version, EV_VERSION, into an int.
%define EVIOCGID      0x80084502 ; _IOR('E', 0x02, struct input_id): the device's identity.
; _IOR('E', 0x03, unsigned int[2]): the auto-repeat's delay and period in ms.
%define EVIOCGREP     0x80084503
; _IOW('E', 0x03, unsigned int[2]): ask for another delay and period.
%define EVIOCSREP     0x40084503
%define EVIOCGKEYCODE 0x80084504 ; _IOR('E', 0x04, unsigned int[2])
%define EVIOCSKEYCODE 0x40084504 ; _IOW('E', 0x04, unsigned int[2])

; Read the device name into a buffer of len bytes, such as "AT Translated Set 2 keyboard".
%define EVIOCGNAME(len) _IOC(_IOC_READ, 'E', 0x06, len)

; Where the device is connected, such as "isa0060/serio0/input0".
%define EVIOCGPHYS(len) _IOC(_IOC_READ, 'E', 0x07, len)

; The device's serial number, if it has one.
%define EVIOCGUNIQ(len) _IOC(_IOC_READ, 'E', 0x08, len)

; The device's INPUT_PROP_* bits.
%define EVIOCGPROP(len) _IOC(_IOC_READ, 'E', 0x09, len)

; Read held keys and buttons into a bit set of len bytes, one bit per code. Also discard queued
; EV_KEY events for this reader.
%define EVIOCGKEY(len) _IOC(_IOC_READ, 'E', 0x18, len)

; The lights lit now, one bit per LED_* code.
%define EVIOCGLED(len) _IOC(_IOC_READ, 'E', 0x19, len)

; The sounds playing now, one bit per SND_* code.
%define EVIOCGSND(len) _IOC(_IOC_READ, 'E', 0x1a, len)
%define EVIOCGSW(len) _IOC(_IOC_READ, 'E', 0x1b, len)

; Read supported codes for event type ev into a bit set of len bytes. With ev equal to 0, read
; supported event types instead.
%define EVIOCGBIT(ev,len) _IOC(_IOC_READ, 'E', 0x20 + (ev), len)

; Read the current value and range for axis code abs, such as ABS_X, into struct input_absinfo.
; Queued events remain unchanged.
%define EVIOCGABS(abs) _IOC(_IOC_READ, 'E', 0x40 + (abs), input_absinfo_size)

; Change the axis abs's struct input_absinfo.
%define EVIOCSABS(abs) _IOC(_IOC_WRITE, 'E', 0xc0 + (abs), input_absinfo_size)

; _IOW('E', 0x90, int): an immediate integer 1 gives this reader exclusive events; 0 releases the
; device.
%define EVIOCGRAB     0x40044590
%define EVIOCREVOKE   0x40044591 ; _IOW('E', 0x91, int)
; _IOW('E', 0xa0, int): the clock of the event times: CLOCK_REALTIME, CLOCK_MONOTONIC or
; CLOCK_BOOTTIME.
%define EVIOCSCLOCKID 0x400445a0

; Where each part of a struct input_id is in an array of four __u16.
%define ID_BUS     0
%define ID_VENDOR  1
%define ID_PRODUCT 2
%define ID_VERSION 3

; input_id's bustype. The keyboard is on BUS_I8042, the tablet on BUS_USB, the PC speaker on
; BUS_ISA.
%define BUS_PCI         0x1
%define BUS_ISAPNP      0x2
%define BUS_USB         0x3
%define BUS_HIL         0x4
%define BUS_BLUETOOTH   0x5
%define BUS_VIRTUAL     0x6
%define BUS_ISA         0x10
%define BUS_I8042       0x11
%define BUS_XTKBD       0x12
%define BUS_RS232       0x13
%define BUS_GAMEPORT    0x14
%define BUS_PARPORT     0x15
%define BUS_AMIGA       0x16
%define BUS_ADB         0x17
%define BUS_I2C         0x18
%define BUS_HOST        0x19
%define BUS_GSC         0x1a
%define BUS_ATARI       0x1b
%define BUS_SPI         0x1c
%define BUS_RMI         0x1d
%define BUS_CEC         0x1e
%define BUS_INTEL_ISHTP 0x1f
%define BUS_AMD_SFH     0x20

%endif
