; time.inc: the constants and structures of <time.h> for NASM, under the same names: struct
; timespec, a time in seconds and nanoseconds, and the clocks the clock_gettime system call reads.
;
; A structure is a struc: name.field is a field's offset, name.outer.inner one of a structure inside
; it, and name_size its size. Use it as [rdi + input_event.code], or reserve one with resb
; input_event_size.
;
; Generated by scripts/sim-header/generate.mjs from scripts/sim-header/deviceTable.mjs. Do not edit
; it: regenerate it.
%ifndef TIME_INC
%define TIME_INC

; A time in seconds and nanoseconds.
; timespec_size is 16.
struc timespec
    .tv_sec:  resq 1 ; Whole seconds.
    .tv_nsec: resq 1 ; Nanoseconds, 0 to 999999999.
endstruc

; The clocks. Every one runs on the program's own time, which a Testcase makes virtual.
%define CLOCK_REALTIME           0 ; The date and time, which can jump.
%define CLOCK_MONOTONIC          1 ; Time since an arbitrary start, which never goes back.
%define CLOCK_PROCESS_CPUTIME_ID 2 ; Processor time this program used.
%define CLOCK_THREAD_CPUTIME_ID  3 ; Processor time this thread used.
%define CLOCK_MONOTONIC_RAW      4
%define CLOCK_REALTIME_COARSE    5
%define CLOCK_MONOTONIC_COARSE   6
%define CLOCK_BOOTTIME           7 ; Like CLOCK_MONOTONIC, counting suspended time too.

%endif
