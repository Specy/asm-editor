; linux/input-event-codes.inc: the constants and structures of <linux/input-event-codes.h> for NASM,
; under the same names: the numbers in an input event: its type (EV_KEY, EV_ABS, ...) and its code
; (KEY_A, BTN_LEFT, ABS_X, ...). Keys are physical keys, whatever the keyboard layout: KEY_Q is the
; key left of W, which an AZERTY keyboard labels A.
;
; A structure is a struc: name.field is a field's offset, name.outer.inner one of a structure inside
; it, and name_size its size. Use it as [rdi + input_event.code], or reserve one with resb
; input_event_size.
;
; Generated by scripts/sim-header/generate.mjs from scripts/sim-header/deviceTable.mjs. Do not edit
; it: regenerate it.
%ifndef LINUX_INPUT_EVENT_CODES_INC
%define LINUX_INPUT_EVENT_CODES_INC

; Properties of a device, which EVIOCGPROP reads as bits.
%define INPUT_PROP_POINTER        0x0
%define INPUT_PROP_DIRECT         0x1
%define INPUT_PROP_BUTTONPAD      0x2
%define INPUT_PROP_SEMI_MT        0x3
%define INPUT_PROP_TOPBUTTONPAD   0x4
%define INPUT_PROP_POINTING_STICK 0x5
%define INPUT_PROP_ACCELEROMETER  0x6
%define INPUT_PROP_MAX            0x1f
%define INPUT_PROP_CNT            (INPUT_PROP_MAX + 1)

; Event types: struct input_event's type.
%define EV_SYN       0x0  ; The end of a report, SYN_REPORT, or lost events, SYN_DROPPED.
%define EV_KEY       0x1  ; A key or button: value 1 down, 0 up, 2 a repeat.
%define EV_REL       0x2  ; A relative movement, such as a wheel notch.
%define EV_ABS       0x3  ; An absolute position, such as the tablet's.
%define EV_MSC       0x4  ; Anything else, such as the scan code before a key.
%define EV_SW        0x5
%define EV_LED       0x11 ; A keyboard light.
%define EV_SND       0x12 ; A sound, written to the PC speaker.
%define EV_REP       0x14
%define EV_FF        0x15
%define EV_PWR       0x16
%define EV_FF_STATUS 0x17
%define EV_MAX       0x1f
%define EV_CNT       (EV_MAX + 1)

; EV_SYN's codes.
%define SYN_REPORT    0 ; The events since the last one belong together.
%define SYN_CONFIG    1
%define SYN_MT_REPORT 2
%define SYN_DROPPED   3 ; The queue overflowed: events were lost.
%define SYN_MAX       15
%define SYN_CNT       (SYN_MAX + 1)

