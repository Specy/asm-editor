; signal.inc: the constants and structures of <signal.h> for NASM, under the same names: the
; signals' numbers, rt_sigaction's flags and struct kernel_sigaction, what the rt_sigaction system
; call takes: a handler needs SA_RESTORER and an sa_restorer that makes rt_sigreturn (mov eax, 15
; then syscall), which the handler's ret returns to.
;
; A structure is a struc: name.field is a field's offset, name.outer.inner one of a structure inside
; it, and name_size its size. Use it as [rdi + input_event.code], or reserve one with resb
; input_event_size.
;
; Generated by scripts/sim-header/generate.mjs from scripts/sim-header/deviceTable.mjs. Do not edit
; it: regenerate it.
%ifndef SIGNAL_INC
%define SIGNAL_INC

; The signals. Those with a comment are the ones a program here meets.
%define SIGHUP    1
%define SIGINT    2  ; Ctrl+C in the Terminal.
%define SIGQUIT   3  ; Ctrl+\ in the Terminal.
%define SIGILL    4  ; An instruction the processor does not have.
%define SIGTRAP   5
%define SIGABRT   6  ; abort()
%define SIGIOT    6
%define SIGBUS    7
%define SIGFPE    8  ; A division by zero.
%define SIGKILL   9  ; Ends the program; it cannot be handled.
%define SIGUSR1   10 ; The program's own.
%define SIGSEGV   11 ; Memory the program may not touch.
%define SIGUSR2   12 ; The program's own.
%define SIGPIPE   13
%define SIGALRM   14 ; alarm's and setitimer's timer.
%define SIGTERM   15
%define SIGSTKFLT 16
%define SIGCHLD   17
%define SIGCONT   18
%define SIGSTOP   19
%define SIGTSTP   20
%define SIGTTIN   21
%define SIGTTOU   22
%define SIGURG    23
%define SIGXCPU   24
%define SIGXFSZ   25
%define SIGVTALRM 26
%define SIGPROF   27
%define SIGWINCH  28
%define SIGIO     29
%define SIGPOLL   29
%define SIGPWR    30
%define SIGSYS    31
%define NSIG      65 ; One more than the highest signal number.

%define SIG_DFL 0  ; The signal's default action: SIGINT ends the program.
%define SIG_IGN 1  ; Ignore the signal.
%define SIG_ERR -1 ; What signal returns when it fails.

; sigprocmask's how.
%define SIG_BLOCK   0 ; Block the signals of the set too.
%define SIG_UNBLOCK 1 ; Stop blocking them.
%define SIG_SETMASK 2 ; Block exactly them.

; sa_flags: how a handler runs.
%define SA_NOCLDSTOP 0x1
%define SA_NOCLDWAIT 0x2
%define SA_SIGINFO   0x4        ; The handler is sa_sigaction, which also gets a siginfo_t.
%define SA_ONSTACK   0x8000000
; A read or wait the signal interrupts starts over instead of failing with EINTR.
%define SA_RESTART   0x10000000
%define SA_NODEFER   0x40000000 ; Do not block the signal while its handler runs.
%define SA_RESETHAND 0x80000000 ; Handle the signal once, then go back to SIG_DFL.
; The kernel's, not in the C library's header: sa_restorer holds what a handler returns to.
; rt_sigaction refuses a handler without it, and sigaction sets it for you.
%define SA_RESTORER  0x4000000

; What a handler with SA_SIGINFO gets about the signal: its number, why it came (si_code) and from
; whom, si_pid, or for SIGSEGV the address, si_addr.
; siginfo_t_size is 128.
struc siginfo_t
    .si_signo:  resd 1   ; The signal's number.
    .si_errno:  resd 1
    .si_code:   resd 1   ; Why it came.
    .__pad0:    resd 1
    ._sifields: resb 112 ; The rest, by si_code.
endstruc

; What the rt_sigaction system call takes, which sigaction makes from a struct sigaction. In
; assembly: k_sa_handler the handler, sa_flags with SA_RESTORER, sa_restorer the code the handler
; returns to, and 8, the size of sa_mask, as rt_sigaction's fourth argument.
; kernel_sigaction_size is 32.
struc kernel_sigaction
    .k_sa_handler: resq 1 ; The handler, or SIG_DFL or SIG_IGN.
    .sa_flags:     resq 1 ; SA_RESTORER and the others.
    .sa_restorer:  resq 1 ; Code that makes rt_sigreturn.
    .sa_mask:      resq 1 ; The signals blocked while the handler runs.
endstruc

%endif
