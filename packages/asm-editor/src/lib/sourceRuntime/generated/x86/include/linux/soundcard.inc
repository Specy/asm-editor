; linux/soundcard.inc: the constants and structures of <linux/soundcard.h> for NASM, under the same
; names: OSS, sampled sound through /dev/dsp and its volumes through /dev/mixer. A program sets the
; format, the channels and the rate, in that order, then writes samples: a write waits while the
; device's buffer is full, so the sound paces the program.
;
; A structure is a struc: name.field is a field's offset, name.outer.inner one of a structure inside
; it, and name_size its size. Use it as [rdi + input_event.code], or reserve one with resb
; input_event_size.
;
; Generated by scripts/sim-header/generate.mjs from scripts/sim-header/deviceTable.mjs. Do not edit
; it: regenerate it.
%ifndef LINUX_SOUNDCARD_INC
%define LINUX_SOUNDCARD_INC

%include "linux/ioctl.inc"

%define SOUND_VERSION 0x30802 ; The OSS version this header describes.

; OSS's names for the ioctl macros of <linux/ioctl.h>.
; /dev/dsp's requests. Each one that sets something writes back what it set, which can differ from
; what was asked: check it.
; _SIO('P', 0): stop at once and drop the samples not played.
%define SNDCTL_DSP_RESET       0x5000
; _SIO('P', 1): wait until every sample written has played.
%define SNDCTL_DSP_SYNC        0x5001
; _SIOWR('P', 2, int): set the sample rate and write back the selected value, from 1000 to 192000
; samples per second; initially 8000.
%define SNDCTL_DSP_SPEED       0xc0045002
; _SIOWR('P', 3, int): 0 mono, 1 stereo: the old way of SNDCTL_DSP_CHANNELS.
%define SNDCTL_DSP_STEREO      0xc0045003
; _SIOWR('P', 4, int): read the selected fragment size in bytes.
%define SNDCTL_DSP_GETBLKSIZE  0xc0045004
; _SIOWR('P', 5, int): set an AFMT_* sample format and write back the selected value; initially
; AFMT_U8.
%define SNDCTL_DSP_SETFMT      0xc0045005
%define SNDCTL_DSP_SAMPLESIZE  SNDCTL_DSP_SETFMT
; _SIOWR('P', 6, int): set the channel count, 1 to 128, and write back the selected value: 1 is
; mono, 2 stereo.
%define SNDCTL_DSP_CHANNELS    0xc0045006
; _SIO('P', 8): start playing what has been written, even an unfinished fragment.
%define SNDCTL_DSP_POST        0x5008
%define SNDCTL_DSP_SUBDIVIDE   0xc0045009 ; _SIOWR('P', 9, int)
; _SIOWR('P', 10, int): request the buffer configuration through an int pointer: 0xMMMMSSSS requests
; MMMM fragments of 2^SSSS bytes. Call immediately after open; only one request can succeed per
; playback open. A smaller buffer reduces queued playback delay.
%define SNDCTL_DSP_SETFRAGMENT 0xc004500a
; _SIOR('P', 11, int): the formats the device takes, AFMT_* bits.
%define SNDCTL_DSP_GETFMTS     0x8004500b

; Sample formats: one sample of one channel. The NE ones are the native byte order, little-endian on
; x86.
%define AFMT_QUERY     0x0  ; With SNDCTL_DSP_SETFMT: read the format without changing it.
%define AFMT_MU_LAW    0x1
%define AFMT_A_LAW     0x2
%define AFMT_IMA_ADPCM 0x4
%define AFMT_U8        0x8  ; Unsigned 8-bit: 128 is silence.
%define AFMT_S16_LE    0x10 ; Signed 16-bit, little-endian: 0 is silence.
%define AFMT_S16_BE    0x20
%define AFMT_S8        0x40
%define AFMT_U16_LE    0x80
%define AFMT_U16_BE    0x100
%define AFMT_MPEG      0x200
%define AFMT_AC3       0x400
%define AFMT_S16_NE    AFMT_S16_LE

; OSS 4's names for formats Linux's own <linux/soundcard.h> leaves out: a program that names them
; builds here and not against Linux's header, where it defines them itself. Linux's OSS emulation
; takes the values all the same.
%define AFMT_S32_LE     0x1000  ; Signed 32-bit, little-endian.
%define AFMT_S32_BE     0x2000
%define AFMT_S24_LE     0x8000  ; Signed 24-bit in 32 bits, little-endian.
%define AFMT_S24_BE     0x10000
%define AFMT_S24_PACKED 0x40000 ; Signed 24-bit in 3 bytes, little-endian.

; Playback buffer capacity and free space returned by SNDCTL_DSP_GETOSPACE. Total capacity in bytes
; is fragstotal * fragsize.
; audio_buf_info_size is 16.
struc audio_buf_info
    .fragments:  resd 1 ; Whole free fragments; may be negative while a partial fragment is staged.
    .fragstotal: resd 1 ; Total fragment count; capacity is fragstotal times fragsize bytes.
    .fragsize:   resd 1 ; Fragment size in bytes, also returned by SNDCTL_DSP_GETBLKSIZE.
    .bytes:      resd 1 ; Free bytes; can be negative while a partial fragment is staged.
endstruc

; _SIOR('P', 12, audio_buf_info): read playback buffer capacity and free space into audio_buf_info.
%define SNDCTL_DSP_GETOSPACE  0x8010500c
%define SNDCTL_DSP_GETISPACE  0x8010500d ; _SIOR('P', 13, audio_buf_info)
%define SNDCTL_DSP_NONBLOCK   0x500e     ; _SIO('P', 14): turn O_NONBLOCK on.
; _SIOR('P', 15, int): what the device can do, DSP_CAP_* bits.
%define SNDCTL_DSP_GETCAPS    0x8004500f
%define DSP_CAP_REVISION      0xff
%define DSP_CAP_DUPLEX        0x100
%define DSP_CAP_REALTIME      0x200
%define DSP_CAP_BATCH         0x400
%define DSP_CAP_COPROC        0x800
%define DSP_CAP_TRIGGER       0x1000
%define DSP_CAP_MMAP          0x2000     ; mmap of /dev/dsp: not here, so a program writes instead.
%define DSP_CAP_MULTI         0x4000
%define DSP_CAP_BIND          0x8000
%define SNDCTL_DSP_GETTRIGGER 0x80045010 ; _SIOR('P', 16, int)
%define SNDCTL_DSP_SETTRIGGER 0x40045010 ; _SIOW('P', 16, int)
%define PCM_ENABLE_INPUT      0x1
%define PCM_ENABLE_OUTPUT     0x2

; What SNDCTL_DSP_GETOPTR reads.
; count_info_size is 12.
struc count_info
    .bytes:  resd 1 ; Bytes played so far.
    .blocks: resd 1 ; Fragments played since the last call.
    .ptr:    resd 1
endstruc

%define SNDCTL_DSP_GETIPTR   0x800c5011 ; _SIOR('P', 17, count_info)
%define SNDCTL_DSP_GETOPTR   0x800c5012 ; _SIOR('P', 18, count_info)
%define SNDCTL_DSP_SETSYNCRO 0x5015     ; _SIO('P', 21)
%define SNDCTL_DSP_SETDUPLEX 0x5016     ; _SIO('P', 22)
; _SIOR('P', 23, int): read bytes submitted for playback but not yet heard, excluding an incomplete
; staged fragment.
%define SNDCTL_DSP_GETODELAY 0x80045017

; The older names of the same requests.
%define SOUND_PCM_WRITE_BITS     SNDCTL_DSP_SETFMT
%define SOUND_PCM_WRITE_CHANNELS SNDCTL_DSP_CHANNELS
%define SOUND_PCM_WRITE_RATE     SNDCTL_DSP_SPEED
%define SOUND_PCM_READ_RATE      0x80045002 ; _SIOR('P', 2, int)
%define SOUND_PCM_READ_CHANNELS  0x80045006 ; _SIOR('P', 6, int)
%define SOUND_PCM_READ_BITS      0x80045005 ; _SIOR('P', 5, int)
%define SOUND_PCM_POST           SNDCTL_DSP_POST
%define SOUND_PCM_RESET          SNDCTL_DSP_RESET
%define SOUND_PCM_SYNC           SNDCTL_DSP_SYNC
%define SOUND_PCM_SETFRAGMENT    SNDCTL_DSP_SETFRAGMENT
%define SOUND_PCM_GETFMTS        SNDCTL_DSP_GETFMTS
%define SOUND_PCM_SETFMT         SNDCTL_DSP_SETFMT
%define SOUND_PCM_GETOSPACE      SNDCTL_DSP_GETOSPACE
%define SOUND_PCM_GETCAPS        SNDCTL_DSP_GETCAPS

; The mixer's channels, on /dev/mixer and on /dev/dsp. A level is left in the low byte and right in
; the next, each 0 to 100: 75 | 75 << 8. VOLUME sets the gain of /dev/dsp's sound; the other
; channels, PCM among them, keep what is written to them and change nothing on this card.
%define SOUND_MIXER_NRDEVICES  25   ; How many channels.
%define SOUND_MIXER_VOLUME     0
%define SOUND_MIXER_BASS       1
%define SOUND_MIXER_TREBLE     2
%define SOUND_MIXER_SYNTH      3
%define SOUND_MIXER_PCM        4
%define SOUND_MIXER_SPEAKER    5
%define SOUND_MIXER_LINE       6
%define SOUND_MIXER_MIC        7
%define SOUND_MIXER_CD         8
%define SOUND_MIXER_IMIX       9
%define SOUND_MIXER_ALTPCM     10
%define SOUND_MIXER_RECLEV     11
%define SOUND_MIXER_IGAIN      12
%define SOUND_MIXER_OGAIN      13
%define SOUND_MIXER_LINE1      14
%define SOUND_MIXER_LINE2      15
%define SOUND_MIXER_LINE3      16
%define SOUND_MIXER_DIGITAL1   17
%define SOUND_MIXER_DIGITAL2   18
%define SOUND_MIXER_DIGITAL3   19
%define SOUND_MIXER_PHONEIN    20
%define SOUND_MIXER_PHONEOUT   21
%define SOUND_MIXER_VIDEO      22
%define SOUND_MIXER_RADIO      23
%define SOUND_MIXER_MONITOR    24
%define SOUND_MIXER_NONE       31
%define SOUND_MIXER_RECSRC     0xff ; Recording sources, a bit each.
%define SOUND_MIXER_DEVMASK    0xfe ; The channels the mixer has, a bit each.
%define SOUND_MIXER_RECMASK    0xfd
%define SOUND_MIXER_CAPS       0xfc
%define SOUND_MIXER_STEREODEVS 0xfb ; The channels with a left and right level.
%define SOUND_MIXER_OUTSRC     0xfa
%define SOUND_MIXER_OUTMASK    0xf9
%define SOUND_MASK_VOLUME      (1 << SOUND_MIXER_VOLUME)
%define SOUND_MASK_BASS        (1 << SOUND_MIXER_BASS)
%define SOUND_MASK_TREBLE      (1 << SOUND_MIXER_TREBLE)
%define SOUND_MASK_SYNTH       (1 << SOUND_MIXER_SYNTH)
%define SOUND_MASK_PCM         (1 << SOUND_MIXER_PCM)
%define SOUND_MASK_SPEAKER     (1 << SOUND_MIXER_SPEAKER)
%define SOUND_MASK_LINE        (1 << SOUND_MIXER_LINE)
%define SOUND_MASK_MIC         (1 << SOUND_MIXER_MIC)
%define SOUND_MASK_CD          (1 << SOUND_MIXER_CD)
%define SOUND_MASK_IMIX        (1 << SOUND_MIXER_IMIX)
%define SOUND_MASK_ALTPCM      (1 << SOUND_MIXER_ALTPCM)
%define SOUND_MASK_RECLEV      (1 << SOUND_MIXER_RECLEV)
%define SOUND_MASK_IGAIN       (1 << SOUND_MIXER_IGAIN)
%define SOUND_MASK_OGAIN       (1 << SOUND_MIXER_OGAIN)
%define SOUND_MASK_LINE1       (1 << SOUND_MIXER_LINE1)
%define SOUND_MASK_LINE2       (1 << SOUND_MIXER_LINE2)
%define SOUND_MASK_LINE3       (1 << SOUND_MIXER_LINE3)
%define SOUND_MASK_DIGITAL1    (1 << SOUND_MIXER_DIGITAL1)
%define SOUND_MASK_DIGITAL2    (1 << SOUND_MIXER_DIGITAL2)
%define SOUND_MASK_DIGITAL3    (1 << SOUND_MIXER_DIGITAL3)
%define SOUND_MASK_PHONEIN     (1 << SOUND_MIXER_PHONEIN)
%define SOUND_MASK_PHONEOUT    (1 << SOUND_MIXER_PHONEOUT)
%define SOUND_MASK_VIDEO       (1 << SOUND_MIXER_VIDEO)
%define SOUND_MASK_RADIO       (1 << SOUND_MIXER_RADIO)
%define SOUND_MASK_MONITOR     (1 << SOUND_MIXER_MONITOR)

; Read the level of the channel dev into an int.
%define MIXER_READ(dev) _IOC(_IOC_READ, 'M', dev, 4)

%define SOUND_MIXER_READ_VOLUME     MIXER_READ(SOUND_MIXER_VOLUME)
%define SOUND_MIXER_READ_BASS       MIXER_READ(SOUND_MIXER_BASS)
%define SOUND_MIXER_READ_TREBLE     MIXER_READ(SOUND_MIXER_TREBLE)
%define SOUND_MIXER_READ_SYNTH      MIXER_READ(SOUND_MIXER_SYNTH)
%define SOUND_MIXER_READ_PCM        MIXER_READ(SOUND_MIXER_PCM)
%define SOUND_MIXER_READ_SPEAKER    MIXER_READ(SOUND_MIXER_SPEAKER)
%define SOUND_MIXER_READ_LINE       MIXER_READ(SOUND_MIXER_LINE)
%define SOUND_MIXER_READ_MIC        MIXER_READ(SOUND_MIXER_MIC)
%define SOUND_MIXER_READ_CD         MIXER_READ(SOUND_MIXER_CD)
%define SOUND_MIXER_READ_IMIX       MIXER_READ(SOUND_MIXER_IMIX)
%define SOUND_MIXER_READ_ALTPCM     MIXER_READ(SOUND_MIXER_ALTPCM)
%define SOUND_MIXER_READ_RECLEV     MIXER_READ(SOUND_MIXER_RECLEV)
%define SOUND_MIXER_READ_IGAIN      MIXER_READ(SOUND_MIXER_IGAIN)
%define SOUND_MIXER_READ_OGAIN      MIXER_READ(SOUND_MIXER_OGAIN)
%define SOUND_MIXER_READ_LINE1      MIXER_READ(SOUND_MIXER_LINE1)
%define SOUND_MIXER_READ_LINE2      MIXER_READ(SOUND_MIXER_LINE2)
%define SOUND_MIXER_READ_LINE3      MIXER_READ(SOUND_MIXER_LINE3)
%define SOUND_MIXER_READ_RECSRC     MIXER_READ(SOUND_MIXER_RECSRC)
%define SOUND_MIXER_READ_DEVMASK    MIXER_READ(SOUND_MIXER_DEVMASK)
%define SOUND_MIXER_READ_RECMASK    MIXER_READ(SOUND_MIXER_RECMASK)
%define SOUND_MIXER_READ_STEREODEVS MIXER_READ(SOUND_MIXER_STEREODEVS)
%define SOUND_MIXER_READ_CAPS       MIXER_READ(SOUND_MIXER_CAPS)

; Set the level of the channel dev from an int, which it writes back.
%define MIXER_WRITE(dev) _IOC(_IOC_READ | _IOC_WRITE, 'M', dev, 4)

%define SOUND_MIXER_WRITE_VOLUME  MIXER_WRITE(SOUND_MIXER_VOLUME)
%define SOUND_MIXER_WRITE_BASS    MIXER_WRITE(SOUND_MIXER_BASS)
%define SOUND_MIXER_WRITE_TREBLE  MIXER_WRITE(SOUND_MIXER_TREBLE)
%define SOUND_MIXER_WRITE_SYNTH   MIXER_WRITE(SOUND_MIXER_SYNTH)
%define SOUND_MIXER_WRITE_PCM     MIXER_WRITE(SOUND_MIXER_PCM)
%define SOUND_MIXER_WRITE_SPEAKER MIXER_WRITE(SOUND_MIXER_SPEAKER)
%define SOUND_MIXER_WRITE_LINE    MIXER_WRITE(SOUND_MIXER_LINE)
%define SOUND_MIXER_WRITE_MIC     MIXER_WRITE(SOUND_MIXER_MIC)
%define SOUND_MIXER_WRITE_CD      MIXER_WRITE(SOUND_MIXER_CD)
%define SOUND_MIXER_WRITE_IMIX    MIXER_WRITE(SOUND_MIXER_IMIX)
%define SOUND_MIXER_WRITE_ALTPCM  MIXER_WRITE(SOUND_MIXER_ALTPCM)
%define SOUND_MIXER_WRITE_RECLEV  MIXER_WRITE(SOUND_MIXER_RECLEV)
%define SOUND_MIXER_WRITE_IGAIN   MIXER_WRITE(SOUND_MIXER_IGAIN)
%define SOUND_MIXER_WRITE_OGAIN   MIXER_WRITE(SOUND_MIXER_OGAIN)
%define SOUND_MIXER_WRITE_LINE1   MIXER_WRITE(SOUND_MIXER_LINE1)
%define SOUND_MIXER_WRITE_LINE2   MIXER_WRITE(SOUND_MIXER_LINE2)
%define SOUND_MIXER_WRITE_LINE3   MIXER_WRITE(SOUND_MIXER_LINE3)
%define SOUND_MIXER_WRITE_RECSRC  MIXER_WRITE(SOUND_MIXER_RECSRC)

; What SOUND_MIXER_INFO reads: the mixer's names.
; mixer_info_size is 92.
struc mixer_info
    .id:             resb 16
    .name:           resb 32
    .modify_counter: resd 1 ; Counts the changes to the levels.
    .fillers:        resd 10
endstruc

%define SOUND_MIXER_INFO 0x805c4d65 ; _SIOR('M', 101, mixer_info)

%endif
