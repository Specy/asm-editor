; linux/kd.inc: the constants and structures of <linux/kd.h> for NASM, under the same names: the
; console's requests. Opened as /dev/tty0, the console sounds the PC speaker. The program's own
; terminal is a serial line, so the other requests answer ENOTTY there.
;
; A structure is a struc: name.field is a field's offset, name.outer.inner one of a structure inside
; it, and name_size its size. Use it as [rdi + input_event.code], or reserve one with resb
; input_event_size.
;
; Generated by scripts/sim-header/generate.mjs from scripts/sim-header/deviceTable.mjs. Do not edit
; it: regenerate it.
%ifndef LINUX_KD_INC
%define LINUX_KD_INC

; Sound the PC speaker with the argument as the timer's period, 1193182 / frequency, until a 0 stops
; it.
%define KIOCSOUND   0x4b2f
; Sound a tone for a while: the period as for KIOCSOUND in the low 16 bits, the time in ms in the
; high 16.
%define KDMKTONE    0x4b30
%define KDGETMODE   0x4b3b ; Read whether the console shows text or graphics.
%define KDSETMODE   0x4b3a ; Make the console show text or let a program draw.
%define KD_TEXT     0x0
%define KD_GRAPHICS 0x1
%define KDGKBMODE   0x4b44 ; Read how the console's keyboard reports keys.
%define KDSKBMODE   0x4b45 ; Change it.
%define K_RAW       0x0
%define K_XLATE     0x1
%define K_MEDIUMRAW 0x2
%define K_UNICODE   0x3
%define K_OFF       0x4

%endif
