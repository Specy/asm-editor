; dirent.inc: the constants and structures of <dirent.h> for NASM, under the same names: struct
; dirent, one entry of what the getdents64 system call reads from a directory, and the types of its
; d_type.
;
; A structure is a struc: name.field is a field's offset, name.outer.inner one of a structure inside
; it, and name_size its size. Use it as [rdi + input_event.code], or reserve one with resb
; input_event_size.
;
; Generated by scripts/sim-header/generate.mjs from scripts/sim-header/deviceTable.mjs. Do not edit
; it: regenerate it.
%ifndef DIRENT_INC
%define DIRENT_INC

; One entry of a directory, as readdir gives it.
; dirent_size is 280.
struc dirent
    .d_ino:    resq 1   ; The entry's file number.
    .d_off:    resq 1
    .d_reclen: resw 1   ; The entry's own size in the directory's buffer.
    .d_type:   resb 1   ; What it is: DT_CHR, DT_DIR, DT_REG, ...
    .d_name:   resb 256 ; Its name, ending with a NUL.
               resb 5   ; padding.
endstruc

; d_type: what an entry is.
%define DT_UNKNOWN 0
%define DT_FIFO    1
%define DT_CHR     2  ; A character device, such as /dev/fb0 or an input device.
%define DT_DIR     4  ; A directory.
%define DT_BLK     6
%define DT_REG     8  ; A file.
%define DT_LNK     10 ; A symbolic link, such as those under /dev/input/by-id.
%define DT_SOCK    12

%endif
