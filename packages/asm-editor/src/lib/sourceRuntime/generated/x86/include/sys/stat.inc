; sys/stat.inc: the constants and structures of <sys/stat.h> for NASM, under the same names: struct
; stat, which the stat, fstat and lstat system calls fill in, and the type and permission bits of
; its st_mode: S_IFCHR for a device such as /dev/fb0.
;
; A structure is a struc: name.field is a field's offset, name.outer.inner one of a structure inside
; it, and name_size its size. Use it as [rdi + input_event.code], or reserve one with resb
; input_event_size.
;
; Generated by scripts/sim-header/generate.mjs from scripts/sim-header/deviceTable.mjs. Do not edit
; it: regenerate it.
%ifndef SYS_STAT_INC
%define SYS_STAT_INC

%include "bits/types/struct_timespec.inc"

; What stat, fstat and lstat fill in, as Linux lays it out on x86-64.
; stat_size is 144.
struc stat
    .st_dev:           resq 1 ; The device the file is on.
    .st_ino:           resq 1 ; The file's number.
    .st_nlink:         resq 1 ; How many names it has.
    .st_mode:          resd 1 ; Its type (S_IFMT) and permission bits.
    .st_uid:           resd 1 ; Its owner.
    .st_gid:           resd 1 ; Its group.
    .__pad0:           resd 1
    ; For a device, which one: (major << 8) | minor here, 0x1d00 for /dev/fb0.
    .st_rdev:          resq 1
    .st_size:          resq 1 ; Its size in bytes.
    .st_blksize:       resq 1
    .st_blocks:        resq 1
    .st_atim:                 ; When it was last read.
    .st_atim.tv_sec:   resq 1 ; Whole seconds.
    .st_atim.tv_nsec:  resq 1 ; Nanoseconds, 0 to 999999999.
    .st_mtim:                 ; When it was last written.
    .st_mtim.tv_sec:   resq 1 ; Whole seconds.
    .st_mtim.tv_nsec:  resq 1 ; Nanoseconds, 0 to 999999999.
    .st_ctim:                 ; When its details last changed.
    .st_ctim.tv_sec:   resq 1 ; Whole seconds.
    .st_ctim.tv_nsec:  resq 1 ; Nanoseconds, 0 to 999999999.
    .__glibc_reserved: resq 3
endstruc

; st_mode's file types: compare st_mode & S_IFMT with one, or use S_ISCHR and the rest.
%define S_IFMT   0o170000 ; The bits that hold the type.
%define S_IFSOCK 0o140000
%define S_IFLNK  0o120000 ; A symbolic link, which lstat sees and stat follows.
%define S_IFREG  0o100000 ; A file.
%define S_IFBLK  0o60000
%define S_IFDIR  0o40000  ; A directory.
%define S_IFCHR  0o20000  ; A character device: every device here.
%define S_IFIFO  0o10000

; Whether st_mode is a file's: 1 or 0.
%define S_ISREG(mode) (((mode) & S_IFMT) == S_IFREG)

; A directory.
%define S_ISDIR(mode) (((mode) & S_IFMT) == S_IFDIR)

; A character device.
%define S_ISCHR(mode) (((mode) & S_IFMT) == S_IFCHR)
%define S_ISBLK(mode) (((mode) & S_IFMT) == S_IFBLK)
%define S_ISFIFO(mode) (((mode) & S_IFMT) == S_IFIFO)
%define S_ISLNK(mode) (((mode) & S_IFMT) == S_IFLNK)
%define S_ISSOCK(mode) (((mode) & S_IFMT) == S_IFSOCK)

; The permission bits: read, write and run, for the owner, the group and others.
%define S_ISUID 0o4000
%define S_ISGID 0o2000
%define S_ISVTX 0o1000
%define S_IRWXU 0o700
%define S_IRUSR 0o400
%define S_IWUSR 0o200
%define S_IXUSR 0o100
%define S_IRWXG 0o70
%define S_IRGRP 0o40
%define S_IWGRP 0o20
%define S_IXGRP 0o10
%define S_IRWXO 0o7
%define S_IROTH 0o4
%define S_IWOTH 0o2
%define S_IXOTH 0o1

%endif
