; fcntl.inc: the constants and structures of <fcntl.h> for NASM, under the same names: the open
; system call's flags and fcntl's commands: a program that polls a device in a loop opens it with
; O_NONBLOCK.
;
; A structure is a struc: name.field is a field's offset, name.outer.inner one of a structure inside
; it, and name_size its size. Use it as [rdi + input_event.code], or reserve one with resb
; input_event_size.
;
; Generated by scripts/sim-header/generate.mjs from scripts/sim-header/deviceTable.mjs. Do not edit
; it: regenerate it.
%ifndef FCNTL_INC
%define FCNTL_INC

; How the file is opened: exactly one of the first three, then any of the others.
%define O_ACCMODE   0o3        ; The bits that hold the first three.
%define O_RDONLY    0          ; For reading.
%define O_WRONLY    0o1        ; For writing.
%define O_RDWR      0o2        ; For reading and writing.
; Create the file if it does not exist, with open's third argument as its mode.
%define O_CREAT     0o100
%define O_EXCL      0o200      ; With O_CREAT: fail with EEXIST if it exists.
%define O_NOCTTY    0o400
%define O_TRUNC     0o1000     ; Empty a file opened for writing.
%define O_APPEND    0o2000     ; Write at the end.
%define O_NONBLOCK  0o4000     ; Never wait: a read with nothing ready fails with EAGAIN.
%define O_DSYNC     0o10000
%define O_DIRECTORY 0o200000   ; Fail unless it is a directory.
%define O_NOFOLLOW  0o400000   ; Fail if it is a symbolic link.
%define O_CLOEXEC   0o2000000  ; Close it in a program started by execve.
%define O_SYNC      0o4010000
%define O_NDELAY    O_NONBLOCK ; The old name of O_NONBLOCK.

; fcntl's commands.
%define F_DUPFD         0 ; Duplicate the descriptor, to the lowest free number from the argument.
%define F_GETFD         1 ; Read the descriptor's flags (FD_CLOEXEC)
%define F_SETFD         2 ; Set the descriptor's flags.
%define F_GETFL         3 ; Read the flags it was opened with (O_NONBLOCK, O_APPEND, ...)
%define F_SETFL         4 ; Change O_NONBLOCK and O_APPEND.
%define F_DUPFD_CLOEXEC 1030
%define FD_CLOEXEC      1 ; The descriptor flag F_GETFD and F_SETFD read and set.

%endif
