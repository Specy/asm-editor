{
    "name": "asm-editor",
    "license": "AGPL-3.0",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "preview": "vp preview",
        "check": "svelte-kit sync && svelte-check --threshold error --tsconfig ./tsconfig.json && tsc --project src/service-worker/tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --threshold error --tsconfig ./tsconfig.json --watch",
        "lint:svelte": "eslint .",
        "test:watch": "vp test",
        "search:model": "node scripts/search-model.mjs",
        "source:help:generate": "node scripts/sim-header/generate.mjs && node scripts/source-language-help/generate.mjs",
        "source:help:check": "node scripts/sim-header/generate.mjs --check && node scripts/source-language-help/generate.mjs --check"
    },
    "dependencies": {
        "@asm-editor/runtime": "workspace:*",
        "@ctrl/tinycolor": "^4.2.1",
        "@discerns/sdk": "^0.1.4",
        "@huggingface/tokenizers": "0.2.0",
        "@orama/orama": "3.1.18",
        "@specy/decompiler": "workspace:*",
        "@specy/mips": "workspace:*",
        "@specy/risc-v": "workspace:*",
        "@specy/s68k": "workspace:*",
        "@specy/x86": "workspace:*",
        "@specy/z80": "link:../z80/packages/z80-machine",
        "@ungap/structured-clone": "^1.4.0",
        "dexie": "^4.4.6",
        "fflate": "0.8.3",
        "hast-util-to-string": "3.0.1",
        "isomorphic-dompurify": "^4.5.0",
        "lz-string": "^1.5.0",
        "monaco-editor": "^0.57.0",
        "onnxruntime-web": "1.30.0",
        "rehype-external-links": "^3.0.0",
        "rehype-raw": "^7.0.0",
        "rehype-stringify": "^10.0.1",
        "remark-gfm": "^4.0.1",
        "remark-parse": "11.0.0",
        "remark-rehype": "^11.1.2",
        "s-ago": "^2.2.0",
        "superjson": "^2.2.6",
        "unified": "11.0.5",
        "unist-util-visit": "^5.1.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@iconify-json/fa-brands": "1.2.2",
        "@iconify-json/fa-regular": "1.2.2",
        "@iconify-json/fa-solid": "1.2.2",
        "@iconify-json/ic": "1.2.4",
        "@iconify-json/octicon": "1.2.39",
        "@sveltejs/adapter-static": "^4.0.0",
        "@sveltejs/kit": "^3.0.1",
        "@sveltejs/load-config": "^0.2.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@types/hast": "^3.0.5",
        "@types/mdast": "^4.0.4",
        "@types/node": "26.6.5",
        "@types/ungap__structured-clone": "^1.2.0",
        "@types/unist": "^3.0.3",
        "@types/wicg-file-system-access": "^2023.10.7",
        "cross-env": "^10.1.0",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.23.1",
        "fake-indexeddb": "6.2.5",
        "globals": "17.13.0",
        "mdsvex": "^0.12.8",
        "onnxruntime-node": "1.30.0",
        "sass": "^1.105.1",
        "svelte": "^5.57.2",
        "svelte-body": "^2.0.0",
        "svelte-check": "^4.7.6",
        "tslib": "^2.8.1",
        "typescript": "catalog:",
        "typescript-eslint": "8.71.2",
        "unplugin-icons": "24.0.0",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
        "vite-plugin-wasm": "^3.6.0",
        "vite-plus": "catalog:"
    },
    "type": "module",
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*",
        "#cmp/*": "./src/components/*",
        "#src/*": "./src/*",
        "#stores/*": "./src/stores/*",
        "#content/*": "./src/content/*"
    }
}
