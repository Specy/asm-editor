{
    "extends": "$app/tsconfig",
    "compilerOptions": {
        "types": [
            "$app/types",
            "@types/wicg-file-system-access",
            "unplugin-icons/types/svelte",
            "vite/client"
        ],
        "lib": ["es2022", "DOM"],
        "target": "es2020",
        "sourceMap": true
    },

    "include": [
        "src/**/*.d.ts",
        "src/**/*.js",
        "src/**/*.ts",
        "src/**/*.svelte",
        "vite.config.ts",
        "vitest.measure.config.ts",
        "scripts/**/*.ts"
    ],
    "exclude": ["src/service-worker"]
}
