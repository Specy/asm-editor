{
    "name": "asm-editor-monorepo",
    "license": "AGPL-3.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.13.0",
    "engines": {
        "node": ">=24.11.0"
    },
    "scripts": {
        "dev": "vp run asm-editor#dev",
        "build": "vp run asm-editor#build",
        "preview": "vp run asm-editor#preview",
        "test": "vp run asm-editor#test",
        "measure": "vp run asm-editor#measure",
        "check": "vp run asm-editor#check",
        "lint": "vp run asm-editor#sync && vp lint && vp run asm-editor#lint:svelte",
        "fix": "vp run asm-editor#sync && vp lint --fix && vp run asm-editor#lint:svelte --fix && vp fmt",
        "format": "vp fmt",
        "format:check": "vp fmt --check",
        "cores:build": "vp run build:cores"
    },
    "devDependencies": {
        "typescript": "catalog:",
        "vite-plus": "catalog:",
        "wrangler": "4.151.0"
    }
}
