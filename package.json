{
    "name": "asm-editor",
    "license": "AGPL-3.0",
    "version": "0.0.1",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "predev": "node scripts/search-model.mjs --optional",
        "dev": "vite dev",
        "prebuild": "node scripts/search-model.mjs",
        "build": "cross-env NODE_OPTIONS=--max_old_space_size=6000 vite build",
        "preview": "vite preview",
        "fix": "eslint --fix . && prettier --write .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "svelte-kit sync && svelte-check --threshold error --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --threshold error --tsconfig ./tsconfig.json --watch",
        "lint": "eslint .",
        "pretest": "node scripts/search-model.mjs --optional",
        "test": "vitest run",
        "test:watch": "vitest",
        "search:model": "node scripts/search-model.mjs",
        "measure": "vitest run --config vitest.measure.config.ts",
        "emulators:init": "git submodule update --init --recursive",
        "emulators:status": "node scripts/local-emulators.mjs status",
        "emulators:local": "node scripts/local-emulators.mjs link",
        "emulators:registry": "node scripts/local-emulators.mjs registry",
        "emulators:build": "npm run emulators:build:mips && npm run emulators:build:risc-v && npm run emulators:build:m68k && npm run emulators:build:x86 && npm run emulators:build:z80",
        "emulators:build:mips": "npm --prefix emulators/mips/marsjs/ts ci && npm --prefix emulators/mips/marsjs/ts run build:all",
        "emulators:build:risc-v": "npm --prefix emulators/risc-v/rarsjs/ts ci && npm --prefix emulators/risc-v/rarsjs/ts run build:all",
        "emulators:build:m68k": "npm --prefix emulators/m68k/ts-lib ci && node scripts/build-local-m68k.mjs",
        "emulators:build:x86": "npm --prefix emulators/x86/blink-js ci && npm --prefix emulators/x86/blink-js run build",
        "emulators:build:x86:wasm": "npm --prefix emulators/x86/blink-js ci && npm --prefix emulators/x86/blink-js run build:wasm && npm run emulators:build:x86",
        "emulators:build:x86:nasm": "emulators/x86/compile_wasm_nasm.sh && npm run emulators:build:x86",
        "emulators:build:z80": "npm --prefix emulators/z80 ci && npm --prefix emulators/z80 run build -- --scope @specy/z80 --include-dependencies"
    },
    "dependencies": {
        "@battlefieldduck/xterm-svelte": "^2.3.0",
        "@cartamd/plugin-code": "^4.2.0",
        "@cartamd/plugin-component": "^1.1.1",
        "@ctrl/tinycolor": "^4.2.1",
        "@discerns/sdk": "^0.1.4",
        "@fontsource/fira-mono": "^5.3.0",
        "@huggingface/tokenizers": "0.2.0",
        "@orama/orama": "3.1.18",
        "@specy/mips": "3.7.0",
        "@specy/risc-v": "3.7.0",
        "@specy/s68k": "2.5.0",
        "@specy/x86": "4.0.0",
        "@specy/z80": "1.1.0",
        "@ungap/structured-clone": "^1.4.0",
        "@xterm/xterm": "^6.0.0",
        "carta-md": "^4.11.3",
        "dexie": "^4.4.6",
        "fflate": "0.8.3",
        "hast-util-to-string": "3.0.1",
        "isomorphic-dompurify": "^4.4.0",
        "lz-string": "^1.5.0",
        "mdast-util-to-string": "4.0.0",
        "monaco-editor": "^0.57.0",
        "onnxruntime-web": "1.30.0",
        "rehype-external-links": "^3.0.0",
        "rehype-raw": "^7.0.0",
        "remark-gfm": "^4.0.1",
        "remark-parse": "11.0.0",
        "s-ago": "^2.2.0",
        "superjson": "^2.2.6",
        "unified": "11.0.5",
        "unist-util-visit": "^5.1.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@iconify-json/fa-brands": "1.2.2",
        "@iconify-json/fa-regular": "1.2.2",
        "@iconify-json/fa-solid": "1.2.2",
        "@iconify-json/ic": "1.2.4",
        "@iconify-json/octicon": "1.2.36",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@types/hast": "^3.0.5",
        "@types/node": "26.6.3",
        "@types/ungap__structured-clone": "^1.2.0",
        "@types/unist": "^3.0.3",
        "@types/wicg-file-system-access": "^2023.10.7",
        "cross-env": "^10.1.0",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.23.0",
        "fake-indexeddb": "6.2.5",
        "mdsvex": "^0.12.8",
        "onnxruntime-node": "1.30.0",
        "prettier": "^3.9.9",
        "prettier-plugin-svelte": "^4.1.1",
        "sass": "^1.105.0",
        "svelte": "^5.57.1",
        "svelte-body": "^2.0.0",
        "svelte-check": "^4.7.6",
        "tslib": "^2.8.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "8.70.1",
        "unplugin-icons": "24.0.0",
        "vite": "^8.3.1",
        "vite-plugin-wasm": "^3.6.0",
        "vitest": "5.0.2"
    },
    "type": "module"
}
