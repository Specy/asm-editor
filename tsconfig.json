{
    "extends": "./.svelte-kit/tsconfig.json",
    "compilerOptions": {
        "types": ["@types/wicg-file-system-access", "unplugin-icons/types/svelte", "vite/client"],
        "lib": ["es2022", "DOM"],
        "target": "es2020",
        "isolatedModules": true,
        "resolveJsonModule": true,
        "sourceMap": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "allowJs": true,
        "checkJs": true
        // baseUrl/paths intentionally omitted: the aliases are declared once in
        // svelte.config.js (kit.alias) and inherited from .svelte-kit/tsconfig.json.
    },

    "include": ["src/**/*.d.ts", "src/**/*.js", "src/**/*.ts", "src/**/*.svelte"]
}
